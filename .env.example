# Shared project. These two values are public connection settings, not admin keys.
# Alternatively populate shared-backend.json to distribute the same backend with GitHub.
STILL_BACKEND=supabase
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_WITH_PUBLIC_KEY

# Local development. Production: use your HTTPS URL and HOST=0.0.0.0.
HOST=127.0.0.1
PORT=4173
OURDAYS_ORIGIN=http://127.0.0.1:4173

# Production requires a private random secret, at least 32 characters.
# Local development generates .local/session.key automatically if omitted.
# STILL_SESSION_SECRET=
# NODE_ENV=production
# OURDAYS_SECURE_COOKIE=1

# Optional executable overrides. Docker configures these automatically.
# FFMPEG_PATH=
# FFPROBE_PATH=
# WHISPER_PATH=
# WHISPER_MODEL=
# MEDIA_KOREAN_FONT=
